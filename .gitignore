.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
app/*.tsbuildinfo
app/next-env.d.ts

# prisma generated
app/app/generated/prisma/

# playwright
app/playwright-report/
app/test-results/
