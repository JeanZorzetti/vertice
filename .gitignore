# next.js
app/.next/
app/out/

# production build
app/build/

# env files — NEVER commit secrets
# Unanchored on purpose: these match in ANY directory, not just app/.
# A .env at the repo root used to slip past the old app/-prefixed patterns.
.env
.env.*
!.env.example

# vercel
.vercel

# spec-kit reference clone (used only to refresh .specify/ scripts; not part of the project)
/spec-kit/

