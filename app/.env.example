# Vértice — variáveis de ambiente
# Copie para .env.local em desenvolvimento. Em produção, configure no dashboard da Vercel.

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Auth / segurança ──────────────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# ── Brevo (e-mail) ────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM=

# ── Cloudflare R2 (storage de assets) ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Meta OAuth ────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Drive (service account) ────────────────────────────────────────────
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_ID=

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_DOMAIN=
NODE_ENV=development

# ── Seed (prisma/seed.ts) ─────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── E2E (e2e/smoke.spec.ts) ───────────────────────────────────────────────────
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASS=
